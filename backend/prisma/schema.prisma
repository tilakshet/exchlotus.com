generator client {
  provider = "prisma-client-js"
}

/// Second generator, same schema/migration history — admin/backend is a
/// separately installed (own node_modules, own Dockerfile) app and needs its
/// own generated client artifact. This is the only thing duplicated; the
/// schema/migrations themselves stay single-source in this file so the two
/// apps can never drift apart on what the database actually looks like.
generator adminClient {
  provider = "prisma-client-js"
  output   = "../../admin/backend/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LedgerEntryType {
  BET
  WIN
  REFUND
  ADJUSTMENT
  DEPOSIT
  WITHDRAWAL
}

/// Suspended players keep every existing row (wallet, ledger, tokens) —
/// this is a status flag the admin panel flips, not a soft/hard delete.
enum PlayerStatus {
  ACTIVE
  SUSPENDED
}

/// Drives which avatar illustration the frontend shows (UserAvatar.tsx).
/// OTHER is also the default for every account that existed before this
/// field was added, and for OTP signups (which don't collect it up front) —
/// those get a neutral avatar until set via profile settings.
enum Gender {
  MALE
  FEMALE
  OTHER
}

model Player {
  id              String       @id @default(uuid())
  /// Matches `user_id` in webhook payloads — the partner-side account identifier.
  externalId      String       @unique
  username        String
  email           String?      @unique
  /// Nullable: the spec's own seeded fixture player (externalId "12345")
  /// predates app-level auth and has no login credentials of its own.
  passwordHash    String?
  /// E.164-ish, digits with a leading "+". The identifier for both OTP
  /// login and password login now — password accounts are created via
  /// phone as well, there's no email+password path in the UI anymore.
  phone           String?      @unique
  /// Captured at signup if a referral code was entered — a denormalized
  /// snapshot only. The Referral row (below) is the real, validated
  /// relationship the reward engine actually acts on; this column is kept
  /// for backward compatibility with anything that reads it directly.
  referredByCode  String?
  /// This account's OWN shareable code — server-generated at registration
  /// (see referral.service.ts generateReferralCode), unique, unrelated to
  /// username so it can't be used to enumerate/impersonate accounts by
  /// guessing usernames. Not user-editable.
  referralCode    String?      @unique
  firstName       String?
  lastName        String?
  dateOfBirth     DateTime?
  /// Drives avatar selection (UserAvatar.tsx) — see the Gender enum doc.
  gender          Gender       @default(OTHER)
  currency        String       @default("INR")
  /// Set only by the admin panel (users.suspend permission). Read by the
  /// player backend on every authenticated request (auth.middleware.ts) and
  /// at login/refresh (auth.service.ts) to reject a suspended account
  /// immediately, not just on its next fresh login.
  status          PlayerStatus @default(ACTIVE)
  /// Bumped on every genuinely new login (auth.service.ts's
  /// issueTokensForNewLogin) — never on a token refresh, which continues the
  /// same session unchanged. Embedded in every access token's `sv` claim;
  /// requireAuth rejects a request the moment its token's `sv` no longer
  /// matches this column, so signing in on a second device invalidates every
  /// other device's session on its very next request (immediately, if that
  /// device also has a live socket connection — see socket.server.ts's
  /// session:revoked push), enforcing one active session per account.
  sessionVersion  Int          @default(0)
  /// Set the first time this phone number is proven via a correct OTP —
  /// either at OTP login/signup (auth.service.ts verifyOtp) or via the
  /// dedicated confirm-phone step KYC requires (kyc.controller.ts), which
  /// exists because a password-signup account (register()) never goes
  /// through OTP at all otherwise. submitKyc refuses to accept documents
  /// until this is set — a PAN card is not proof of *this* phone number.
  phoneVerifiedAt DateTime?
  /// Denormalized "current" status — the one thing requestWithdrawal
  /// (wallet.service.ts) actually checks. KycSubmission below is the
  /// history/audit trail of every attempt; this column is always kept in
  /// sync with that history's latest reviewed outcome (see kyc.service.ts
  /// submitKyc/admin's reviewKyc, both of which update both together in one
  /// transaction) so the withdrawal gate never has to join/query history.
  kycStatus       KycStatus    @default(NOT_SUBMITTED)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  wallet              Wallet?
  entries             LedgerEntry[]
  refreshTokens       RefreshToken[]
  bankAccounts        BankAccount[]
  paymentOrders       PaymentOrder[]
  withdrawalRequests  WithdrawalRequest[]
  tickets             SupportTicket[]
  loginEvents         LoginEvent[]
  kycSubmissions      KycSubmission[]
  passwordResetTokens PasswordResetToken[]
  referralsMade       Referral[]                  @relation("Referrer")
  referralReceived    Referral?                   @relation("Referred")
  referralRewards     ReferralRewardTransaction[]
  gameLaunchFailures  GameLaunchFailure[]

  @@map("players")
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

/// One row per submission attempt (a rejected player can resubmit) — the
/// durable history/audit trail. Player.kycStatus above is the fast-path
/// "current status" read, kept in sync with whichever row here is latest.
model KycSubmission {
  id                String    @id @default(uuid())
  playerId          String
  player            Player    @relation(fields: [playerId], references: [id])
  panNumber         String
  /// Filenames only (see backend/src/lib/uploads.ts KYC_UPLOAD_DIR) — never
  /// served publicly, unlike support-ticket attachments. Only readable
  /// through admin/backend's authenticated document-streaming route, which
  /// reads them off the same shared uploads volume the player backend wrote
  /// them to (see docker-compose.prod.yml).
  panCardFile       String
  photoFile         String
  status            KycStatus @default(PENDING)
  /// Set only on REJECTED — shown back to the player so they know what to
  /// fix before resubmitting.
  rejectionReason   String?
  /// AdminUser.id from admin/backend's schema — no FK, same reasoning as
  /// LedgerEntry.actorAdminId: this table must stay readable even if that
  /// admin account is later deleted.
  reviewedByAdminId String?
  reviewedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([playerId, createdAt])
  @@index([status])
  @@map("kyc_submissions")
}

model RefreshToken {
  id        String    @id @default(uuid())
  playerId  String
  player    Player    @relation(fields: [playerId], references: [id])
  /// Never store the raw token — only a hash of it, same principle as a password.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([playerId])
  @@map("refresh_tokens")
}

enum LoginEventMethod {
  PASSWORD
  OTP
  REGISTER
}

enum LoginEventResult {
  SUCCESS
  FAILURE
}

/// One row per login/signup attempt — success and failure alike (see
/// auth.service.ts login/verifyOtp/register). This is IP/device tracking +
/// login-anomaly-detection input, not a financial record, so it's
/// best-effort: a write failure here never blocks a real login attempt.
model LoginEvent {
  id        String           @id @default(uuid())
  /// Null when the attempt fails before a matching account is found (e.g.
  /// wrong phone number entirely) — the phone below is still recorded so a
  /// pattern of failed attempts against a not-yet-registered number is
  /// still visible.
  playerId  String?
  player    Player?          @relation(fields: [playerId], references: [id])
  phone     String
  method    LoginEventMethod
  result    LoginEventResult
  /// e.g. "INVALID_CREDENTIALS", "OTP_INVALID", "ACCOUNT_SUSPENDED" — null on success.
  reason    String?
  ipAddress String?
  userAgent String?
  createdAt DateTime         @default(now())

  @@index([playerId, createdAt])
  @@index([phone, createdAt])
  @@index([createdAt])
  @@map("login_events")
}

model Wallet {
  id               String   @id @default(uuid())
  playerId         String   @unique
  player           Player   @relation(fields: [playerId], references: [id])
  /// The real, provider-reconciled playable balance — the only figure the
  /// gaming webhook ever touches.
  balance          Decimal  @db.Decimal(18, 2)
  /// First real consumer: referral cash rewards (referral.service.ts
  /// creditReferralReward). Not wired into betting/withdrawal — no
  /// wagering-requirement engine exists, so this is a tracked, visible
  /// promotional balance only, not yet spendable or withdrawable. Locked/
  /// bonus tracking otherwise has no other backing feature.
  bonusBalance     Decimal  @default(0) @db.Decimal(18, 2)
  /// Referral coin rewards (see ReferralRewardTransaction). Same caveat as
  /// bonusBalance — tracked and visible, not yet spendable on a bet (that
  /// would mean intercepting the real-money gaming webhook flow, out of
  /// scope until a real wagering engine exists).
  bonusCoinBalance Int      @default(0)
  lockedBalance    Decimal  @default(0) @db.Decimal(18, 2)
  currency         String
  updatedAt        DateTime @updatedAt

  @@map("wallets")
}

model LedgerEntry {
  id            String          @id @default(uuid())
  playerId      String
  player        Player          @relation(fields: [playerId], references: [id])
  type          LedgerEntryType
  /// Provider's transaction_id (e.g. "bet_987654"). Not unique alone — spec
  /// §6 notes a refund may reuse the original bet's transaction_id.
  transactionId String
  roundId       String
  gameId        String
  sessionId     String?
  /// Signed: negative for debits (bet), positive for credits (win/refund).
  amount        Decimal         @db.Decimal(18, 2)
  balanceAfter  Decimal         @db.Decimal(18, 2)
  /// Set only when this entry was created by an admin-initiated manual
  /// adjustment (admin/backend's wallets.adjust) — null for every
  /// player/webhook-originated entry. No FK to AdminUser: the admin schema
  /// is a separate concern and must stay readable/queryable even if an
  /// admin account is later deleted (see AdminAuditLog for the durable,
  /// FK'd record of who/why).
  actorAdminId  String?
  createdAt     DateTime        @default(now())

  /// Idempotency key per spec §6: composite unique on (transaction_id, type),
  /// not transaction_id alone. A duplicate insert here is how we detect a
  /// replayed webhook call and skip re-applying the ledger action.
  @@unique([transactionId, type])
  /// Spec §6 "performance lookup index" for round-level queries.
  @@index([playerId, roundId, type])
  @@map("ledger_entries")
}

/// Backing store for "Login with OTP". No SMS gateway is connected — the
/// code is generated and hashed here exactly like a password would be,
/// but auth.service.ts returns it in the response outside production
/// instead of sending it, so the flow is genuinely testable end-to-end
/// without a real provider. Swapping in a real SMS gateway later only
/// touches that one return statement, not this table or the verify logic.
model OtpCode {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@map("otp_codes")
}

/// Forgot-password: a short-lived, single-use credential that lets the
/// "new password" step (auth.service.ts resetPassword) prove it followed a
/// legitimate request-reset step (requestPasswordReset), without an OTP —
/// same hash-only-storage principle as RefreshToken above (a DB leak alone
/// can't be replayed). playerId is nullable so a request for a phone/email
/// with no matching account can still return a same-shaped, never-resolving
/// token instead of revealing whether the account exists.
model PasswordResetToken {
  id        String    @id @default(uuid())
  playerId  String?
  player    Player?   @relation(fields: [playerId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([playerId])
  @@map("password_reset_tokens")
}

enum ReferralStatus {
  PENDING
  REGISTERED
  QUALIFIED
  REWARDED
  REJECTED
  CANCELLED
}

enum ReferralRiskStatus {
  NORMAL
  REVIEW
  BLOCKED
}

/// DUPLICATE_DEVICE/MULTIPLE_ACCOUNTS/UNUSUAL_ACTIVITY exist as values an
/// admin can attach manually (referral.riskFlags admin action) — no device-
/// fingerprinting or cross-account-correlation infra exists in this
/// codebase to auto-detect them. DUPLICATE_IP and RAPID_REGISTRATION are
/// the two auto-detected at attribution time (referral.service.ts).
enum ReferralRiskFlagType {
  SELF_REFERRAL
  DUPLICATE_DEVICE
  DUPLICATE_IP
  RAPID_REGISTRATION
  SUSPICIOUS_PATTERN
  MULTIPLE_ACCOUNTS
  UNUSUAL_ACTIVITY
}

enum ReferralQualificationRule {
  REGISTRATION_ONLY
  VERIFICATION
  DEPOSIT
  ACTIVITY
  /// Registration + deposit >= minDepositAmount + activity >= minActivityAmount, all required.
  MULTIPLE
}

enum ReferralCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum ReferralRewardTxType {
  REFERRAL_CASH_REWARD
  REFERRAL_COIN_REWARD
  REFERRAL_REVERSAL
  REFERRAL_EXPIRY
  ADMIN_ADJUSTMENT
}

enum ReferralRewardTxStatus {
  COMPLETED
  REVERSED
  EXPIRED
}

/// Single global config row (id is always "default" — no multi-tenant
/// need here). A ReferralCampaign, when active, overrides these reward
/// amounts/qualification rule for referrals attributed during its window;
/// this row is what applies the rest of the time. No generic
/// AdminSetting/config table exists elsewhere in this schema to reuse —
/// every admin-configurable value in this codebase today is a hardcoded
/// constant per-feature, so this is the first of its kind, scoped
/// narrowly to referral settings rather than a speculative generic system.
model ReferralSettings {
  id                   String                    @id @default("default")
  enabled              Boolean                   @default(false)
  qualificationRule    ReferralQualificationRule @default(REGISTRATION_ONLY)
  minDepositAmount     Decimal                   @default(0) @db.Decimal(18, 2)
  minActivityAmount    Decimal                   @default(0) @db.Decimal(18, 2)
  referrerCashReward   Decimal                   @default(0) @db.Decimal(18, 2)
  referrerCoinReward   Int                       @default(0)
  referredCashReward   Decimal                   @default(0) @db.Decimal(18, 2)
  referredCoinReward   Int                       @default(0)
  /// Null = never expires.
  rewardExpiryDays     Int?
  maxRewardsPerUser    Int?
  maxReferredPerUser   Int?
  dailyReferralLimit   Int?
  monthlyReferralLimit Int?
  minAccountAgeDays    Int                       @default(0)
  kycRequired          Boolean                   @default(false)
  rewardCooldownHours  Int                       @default(0)
  /// Free-text country codes (e.g. "IN"); empty = no geographic
  /// restriction. Stored but NOT enforced — no IP-geolocation service
  /// exists in this codebase to check a signup's actual country against
  /// this list. Kept so the setting is ready the moment one is added.
  allowedCountries     String[]                  @default([])
  termsText            String?                   @db.Text
  updatedByAdminId     String?
  updatedAt            DateTime                  @updatedAt

  @@map("referral_settings")
}

/// A time-boxed override of ReferralSettings' reward amounts/qualification
/// rule. Referral rows snapshot which campaign (if any) was active at
/// attribution time (campaignId) — changing or ending a campaign later
/// never retroactively changes an already-attributed referral's reward math.
model ReferralCampaign {
  id                 String                    @id @default(uuid())
  name               String
  description        String?
  startAt            DateTime
  endAt              DateTime
  status             ReferralCampaignStatus    @default(DRAFT)
  qualificationRule  ReferralQualificationRule @default(REGISTRATION_ONLY)
  referrerCashReward Decimal                   @default(0) @db.Decimal(18, 2)
  referrerCoinReward Int                       @default(0)
  referredCashReward Decimal                   @default(0) @db.Decimal(18, 2)
  referredCoinReward Int                       @default(0)
  minDepositAmount   Decimal                   @default(0) @db.Decimal(18, 2)
  minActivityAmount  Decimal                   @default(0) @db.Decimal(18, 2)
  /// Null = unlimited total reward issuances under this campaign.
  maxRewards         Int?
  /// Null = falls back to ReferralSettings.rewardExpiryDays.
  expiryDays         Int?
  /// No FK — same convention as WithdrawalRequest.decidedByAdminId etc.:
  /// stays readable if that admin account is later deleted.
  createdByAdminId   String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  referrals Referral[]

  @@index([status, startAt, endAt])
  @@map("referral_campaigns")
}

/// The core attribution record: one row per referred (new) player, created
/// once at registration and never re-pointed to a different referrer
/// afterward (referredId is unique — one referrer per account, enforced at
/// the database level, not just in application code).
model Referral {
  id                    String             @id @default(uuid())
  referrerId            String
  referrer              Player             @relation("Referrer", fields: [referrerId], references: [id])
  referredId            String             @unique
  referred              Player             @relation("Referred", fields: [referredId], references: [id])
  /// Snapshot of the code actually used, even if the referrer's code is
  /// later regenerated (it isn't today, but this keeps history accurate
  /// if that ever changes).
  referralCode          String
  campaignId            String?
  campaign              ReferralCampaign?  @relation(fields: [campaignId], references: [id])
  status                ReferralStatus     @default(REGISTERED)
  riskStatus            ReferralRiskStatus @default(NORMAL)
  riskScore             Int                @default(0)
  registrationIp        String?
  registrationUserAgent String?
  registeredAt          DateTime           @default(now())
  qualifiedAt           DateTime?
  rewardedAt            DateTime?
  rejectedAt            DateTime?
  cancelledAt           DateTime?
  adminNote             String?
  /// No FK — same convention as elsewhere (WithdrawalRequest.decidedByAdminId).
  reviewedByAdminId     String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  riskFlags ReferralRiskFlag[]
  rewards   ReferralRewardTransaction[]

  @@index([referrerId])
  @@index([status])
  @@index([campaignId])
  @@index([riskStatus])
  @@map("referrals")
}

model ReferralRiskFlag {
  id         String               @id @default(uuid())
  referralId String
  referral   Referral             @relation(fields: [referralId], references: [id])
  type       ReferralRiskFlagType
  detail     String?
  createdAt  DateTime             @default(now())

  @@index([referralId])
  @@map("referral_risk_flags")
}

/// The referral reward ledger (spec §6) — separate from LedgerEntry (which
/// represents the real, withdrawable balance and has no BONUS/REFERRAL
/// type) since referral rewards credit the promotional bonusBalance/
/// bonusCoinBalance columns on Wallet instead. Same idempotency principle
/// as LedgerEntry: `reference` is a unique, deterministic key (e.g.
/// "referral:{referralId}:referrer:cash") so issuing a reward twice is a
/// no-op, not a double credit. One row per distinct movement (cash and
/// coin rewards are two separate rows, not packed into one).
model ReferralRewardTransaction {
  id            String                 @id @default(uuid())
  playerId      String
  player        Player                 @relation(fields: [playerId], references: [id])
  referralId    String
  referral      Referral               @relation(fields: [referralId], references: [id])
  type          ReferralRewardTxType
  /// Cash amount for CASH/REVERSAL-of-cash/EXPIRY-of-cash rows, coin count
  /// for COIN rows — semantics follow `type`, same convention as
  /// LedgerEntry.amount (signed: negative for a reversal/expiry).
  amount        Decimal                @default(0) @db.Decimal(18, 2)
  currency      String                 @default("INR")
  balanceBefore Decimal?               @db.Decimal(18, 2)
  balanceAfter  Decimal?               @db.Decimal(18, 2)
  status        ReferralRewardTxStatus @default(COMPLETED)
  reference     String                 @unique
  description   String?
  /// Set on a REFERRAL_REVERSAL/REFERRAL_EXPIRY row, pointing back at the
  /// original reward it reverses — the original row is never deleted or
  /// mutated, financial history stays immutable.
  reversalOfId  String?
  /// No FK — same convention as elsewhere.
  actorAdminId  String?
  expiresAt     DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([playerId])
  @@index([referralId])
  @@index([status])
  @@map("referral_reward_transactions")
}

/// A best-effort record of a FAILED game-session launch (game-session.controller.ts)
/// — never written on a successful launch, so this table adds zero cost/risk
/// to the hot path. Previously a launch failure only ever reached a log
/// line (see logger.error calls in that controller) with no admin
/// visibility at all into which games/players were actually affected.
model GameLaunchFailure {
  id        String   @id @default(uuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id])
  gameId    String
  mode      String
  reason    String
  createdAt DateTime @default(now())

  @@index([gameId, createdAt])
  @@index([playerId, createdAt])
  @@map("game_launch_failures")
}

model Provider {
  id                String   @id @default(uuid())
  code              String   @unique
  name              String
  rtp               Float?
  syncedAt          DateTime @default(now())
  /// Manually confirmed (not derived from any provider API field) that
  /// real-money mode:"real" launches actually work for this studio — see
  /// backend README "Real-money studio enablement". Verified via a direct
  /// POST /v1/sessions/launch call returning session.mode:"real", not
  /// assumed from category/name. Defaults false: only games from a studio
  /// explicitly flagged true here sort ahead of the rest of the catalog —
  /// an unverified studio is treated the same as a known-broken one for
  /// sorting purposes, since "untested" isn't the same as "safe."
  realMoneyVerified Boolean  @default(false)

  games Game[]

  @@map("providers")
}

/// The provider's game catalog (spec §3) carries no category/genre field —
/// categories are our own organizational layer on top, assigned heuristically
/// during catalog sync (see catalog.service.ts) rather than supplied by the
/// provider. Not the provider's data model; ours.
model Category {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  games Game[]

  @@map("categories")
}

model Game {
  id                    String    @id @default(uuid())
  /// Provider's game_id.
  gameId                String    @unique
  gameCode              String
  gameName              String
  providerId            String
  provider              Provider  @relation(fields: [providerId], references: [id])
  categoryId            String?
  category              Category? @relation(fields: [categoryId], references: [id])
  rtp                   Float?
  bannerUrl             String?
  /// Admin-panel toggle (games.manage) — catalog.service.ts filters player-
  /// facing reads to enabled:true and bumps the catalog cache version on
  /// change, so a disabled game disappears from the player app promptly.
  /// Deliberately untouched by syncCatalog() — an admin's manual disable
  /// must survive routine re-syncing, see availableFromProvider below for
  /// the sync-driven equivalent.
  enabled               Boolean   @default(true)
  /// Set true whenever this game appears in a syncCatalog() run, false for
  /// any previously-synced game that didn't (the provider stopped listing
  /// it, without us finding out any other way — there's no delete/removal
  /// signal in their catalog API). Deliberately a separate column from
  /// `enabled`: syncCatalog() must never flip an admin's manual disable
  /// back on just because the provider still lists the game, and an
  /// admin's manual disable must never get silently reversed by a re-sync
  /// either — the two booleans track two unrelated facts about the same
  /// row, and both must be true for the game to actually be launchable.
  availableFromProvider Boolean   @default(true)
  syncedAt              DateTime  @default(now())

  /// Every player-facing catalog query filters enabled:true and
  /// availableFromProvider:true first, then narrows by category or
  /// provider (listGames/listHomeFeed in catalog.service.ts) — Postgres
  /// doesn't auto-index FK columns, and without these the ~15k-row table
  /// falls back to a sequential scan on every cache miss.
  @@index([enabled, availableFromProvider, categoryId])
  @@index([enabled, availableFromProvider, providerId])
  @@map("games")
}

// ---------------------------------------------------------------------------
// Payments (deposits via PayIn, withdrawals via admin-approved Payout) — see
// backend/src/modules/payments and backend/src/modules/bank-accounts.
// ---------------------------------------------------------------------------

/// A player's saved payout destination. Collected up front (not per-withdrawal)
/// so the admin approval step in WithdrawalRequest has account/IFSC to send to.
model BankAccount {
  id                String   @id @default(uuid())
  playerId          String
  player            Player   @relation(fields: [playerId], references: [id])
  accountHolderName String
  bankName          String
  accountNumber     String
  ifsc              String
  createdAt         DateTime @default(now())

  withdrawalRequests WithdrawalRequest[]

  @@index([playerId])
  @@map("bank_accounts")
}

enum PaymentOrderStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

/// One row per deposit attempt. `id` doubles as the `order_id` sent to/
/// received from the gateway — no separate column to keep in sync with it.
model PaymentOrder {
  id           String             @id @default(uuid())
  playerId     String
  player       Player             @relation(fields: [playerId], references: [id])
  amount       Decimal            @db.Decimal(18, 2)
  status       PaymentOrderStatus @default(PENDING)
  /// The gateway's own trx_id from its create-order response — for support/reconciliation lookups.
  gatewayTrxId String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([playerId])
  @@map("payment_orders")
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
  PAID
  FAILED
}

/// Created the instant a player requests a withdrawal (funds move into
/// Wallet.lockedBalance at that point — see wallet.service.ts) but the real
/// payout API call only happens when an admin approves it. No KYC/fraud
/// review exists yet, so nothing pays out unattended.
model WithdrawalRequest {
  id               String           @id @default(uuid())
  playerId         String
  player           Player           @relation(fields: [playerId], references: [id])
  bankAccountId    String
  bankAccount      BankAccount      @relation(fields: [bankAccountId], references: [id])
  amount           Decimal          @db.Decimal(18, 2)
  status           WithdrawalStatus @default(PENDING)
  /// trxid WE generate and send to the payout API — matched back against
  /// the callback's cus_trx_id to identify which request it's updating.
  /// Unique by construction (wd_<request.id>_<random>) and looked up on
  /// every payout webhook (handlePayoutCallback) — @unique gives that
  /// lookup an index instead of a full table scan, and makes the
  /// uniqueness assumption explicit rather than just true by convention.
  gatewayTrxId     String?          @unique
  /// Oro's OWN trx_id from the payout response (distinct from gatewayTrxId
  /// above, which is ours) — required as `apiRefNum` for their Check Payout
  /// Status API, the reconciliation fallback for a missed payout webhook.
  oroTrxId         String?
  gatewayUtr       String?
  /// AdminUser.id from admin/backend's schema — no FK, same reasoning as
  /// LedgerEntry.actorAdminId: this table must stay readable even if that
  /// admin account is later deleted.
  decidedByAdminId String?
  /// Required on reject — shown to the player, kept for audit.
  reason           String?
  requestedAt      DateTime         @default(now())
  decidedAt        DateTime?

  @@index([playerId])
  @@index([status])
  @@map("withdrawal_requests")
}

// ---------------------------------------------------------------------------
// Support (backend/src/modules/support, admin/backend/src/modules/support) —
// a player-raised ticket handled by admin staff. Player-facing and admin-
// facing, unlike everything above/below this block, so it sits between them.
// ---------------------------------------------------------------------------

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportTicket {
  id              String              @id @default(uuid())
  playerId        String
  player          Player              @relation(fields: [playerId], references: [id])
  subject         String
  status          SupportTicketStatus @default(OPEN)
  /// AdminUser.id from admin/backend's schema — no FK, same reasoning as
  /// LedgerEntry.actorAdminId / WithdrawalRequest.decidedByAdminId: this
  /// table must stay readable even if that admin account is later deleted.
  assignedAdminId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  messages SupportMessage[]

  @@index([playerId])
  @@index([status])
  @@map("support_tickets")
}

model SupportMessage {
  id             String        @id @default(uuid())
  ticketId       String
  ticket         SupportTicket @relation(fields: [ticketId], references: [id])
  /// Exactly one of these is set — a message is authored by the player or
  /// an admin, never both/neither. No FK on authorAdminId, same reasoning
  /// as SupportTicket.assignedAdminId.
  authorPlayerId String?
  authorAdminId  String?
  body           String
  /// Public URL of an optionally-attached image, served from backend/'s own
  /// /api/uploads/support static route — absolute (not relative) so
  /// admin/frontend (a different domain) can load it directly. Only ever
  /// set on the player's first message when raising a ticket today (see
  /// support.controller.ts) — the schema doesn't restrict it to that, in
  /// case attachments on replies get added later.
  attachmentUrl  String?
  createdAt      DateTime      @default(now())

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

// ---------------------------------------------------------------------------
// Admin platform (admin/backend, admin/frontend) — entirely separate identity
// and authorization system from Player. An AdminUser is platform staff, never
// a customer; nothing here is reachable from the player-facing backend or JWT.
// See admin/backend/README.md for the auth/RBAC flow these models back.
// ---------------------------------------------------------------------------

enum AdminUserStatus {
  ACTIVE
  DISABLED
}

model AdminUser {
  id                        String          @id @default(uuid())
  email                     String          @unique
  passwordHash              String
  firstName                 String
  lastName                  String
  roleId                    String
  role                      AdminRole       @relation(fields: [roleId], references: [id])
  /// TOTP secret (base32), set once MFA enrollment completes. Null until then.
  mfaSecret                 String?
  mfaEnabled                Boolean         @default(false)
  status                    AdminUserStatus @default(ACTIVE)
  lastLoginAt               DateTime?
  /// The notifications feed (admin/backend's notifications module) is
  /// derived read-only from AdminAuditLog — this is the only state it
  /// needs: "unread" = qualifying audit rows newer than this timestamp.
  lastNotificationsViewedAt DateTime?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  sessions  AdminSession[]
  auditLogs AdminAuditLog[]

  @@map("admin_users")
}

model AdminRole {
  id          String   @id @default(uuid())
  /// SUPER_ADMIN | MANAGER | FINANCE | KYC | SECURITY | RISK | SUPPORT | AUDITOR
  /// (see admin/backend/prisma/seed — kept as a free-text unique key, not an
  /// enum, so new roles can be added by Super Admin without a migration).
  name        String   @unique
  description String?
  /// System roles (seeded ones above) can't be deleted from the admin UI —
  /// only their permission set can be edited. Custom roles can be deleted.
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  admins      AdminUser[]
  permissions AdminRolePermission[]

  @@map("admin_roles")
}

model AdminPermission {
  id          String  @id @default(uuid())
  /// e.g. "wallets.adjust", "withdrawals.approve" — dot-namespaced, matches
  /// the RBAC matrix. Seeded once; the set of valid codes is fixed by what
  /// the admin backend's requirePermission() middleware calls actually check.
  code        String  @unique
  description String?

  roles AdminRolePermission[]

  @@map("admin_permissions")
}

model AdminRolePermission {
  roleId       String
  permissionId String
  role         AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("admin_role_permissions")
}

model AdminSession {
  id          String    @id @default(uuid())
  adminId     String
  admin       AdminUser @relation(fields: [adminId], references: [id])
  /// Opaque refresh token, hashed at rest — same pattern as Player.RefreshToken.
  tokenHash   String    @unique
  ipAddress   String
  userAgent   String
  /// False between password-verified and TOTP-verified during a login that
  /// requires MFA — a session isn't usable for admin-api calls until true.
  mfaVerified Boolean   @default(false)
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([adminId])
  @@map("admin_sessions")
}

/// Append-only. Every mutating admin-api request writes exactly one row here
/// in the same DB transaction as the business change it makes — see
/// admin/backend/src/lib/audit.ts. Never updated or deleted by admin action.
model AdminAuditLog {
  id         String    @id @default(uuid())
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id])
  /// e.g. "wallet.adjust", "user.suspend", "admin.role_changed"
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  reason     String?
  ipAddress  String
  requestId  String
  createdAt  DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([adminId, createdAt])
  @@map("admin_audit_logs")
}
