# Sandbox by default — switch to https://api.cashfree.com for production.
CASHFREE_BASE_URL="https://sandbox.cashfree.com"
CASHFREE_CLIENT_ID="CHANGE_ME"
CASHFREE_CLIENT_SECRET="CHANGE_ME"
CASHFREE_API_VERSION="2023-08-01"

# Transactional SMS (BulkSMSConnect / DIGIXPRESS) for signup & forgot-password
# phone OTP. Leave SMS_ENABLED=false locally — no SMS is sent and the code is
# returned in the API response as `devCode` so the flow stays testable.
SMS_ENABLED=false
SMS_API_BASE_URL="https://bulksmsconnect.in/V2"
SMS_API_KEY=""
SMS_SENDER_ID=""
SMS_TIMEOUT_MS=8000
