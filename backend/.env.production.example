DATABASE_URL="postgresql://exchlotus_app:CHANGE_ME_SAME_AS_ROOT_ENV_PRODUCTION@postgres:5432/exchlotus_dev"
PORT=4000
NODE_ENV=production

# Caches catalog/hero-banner reads (see lib/redis.ts) — a Redis outage
# falls back to direct Postgres reads rather than failing requests.
REDIS_URL="redis://redis:6379"

# Same-origin requests from https://yourdomain.com go through the frontend's
# nginx reverse proxy (no CORS needed there). Origins listed here are for
# cross-origin callers: your and your teammate's local dev frontends (see
# docs/deployment.md "Local dev against the shared VPS backend").
CORS_ORIGIN="https://yourdomain.com,http://localhost:5173,http://127.0.0.1:5173"

# Mock provider runs in-process inside this same container (see server.ts) —
# keep this on localhost, it is not reachable from outside the container.
GAMING_PROVIDER_BASE_URL="http://127.0.0.1:4100/api"
GAMING_PROVIDER_API_KEY="CHANGE_ME"
MOCK_PROVIDER_PORT=4100

GAMING_WEBHOOK_SHARED_SECRET="CHANGE_ME"

# Required to call POST /api/catalog/sync (an operator action, not
# player-facing) — send it as `Authorization: Bearer <this value>`.
CATALOG_SYNC_SECRET="CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET"

JWT_ACCESS_SECRET="CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET"
JWT_REFRESH_SECRET="CHANGE_ME_GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30
