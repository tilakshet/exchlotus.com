DATABASE_URL="postgresql://exchlotus_app:CHANGE_ME_SAME_AS_ROOT_ENV_PRODUCTION@postgres:5432/exchlotus_dev"
PORT=4000
NODE_ENV=production

# Caches catalog/hero-banner reads (see lib/redis.ts) — a Redis outage
# falls back to direct Postgres reads rather than failing requests.
REDIS_URL="redis://redis:6379"

# Same-origin requests from https://yourdomain.com go through the frontend's
# nginx reverse proxy (no CORS needed there). Origins listed here are for
# cross-origin callers: your and your teammate's local dev frontends (see
# docs/deployment.md "Local dev against the shared VPS backend").
CORS_ORIGIN="https://yourdomain.com,http://localhost:5173,http://127.0.0.1:5173"

# Real provider — confirmed reachable and returning real catalog data (see
# backend/README.md "Provider integration — v2 endpoint set"). Only falls
# back to the in-process mock (server.ts) if this is a 127.0.0.1/localhost
# URL, so leaving this as the real host is what keeps the mock OFF in
# production. Session launch (POST /v1/sessions/launch) returns 200 with
# the documented shape but the resulting game_url currently 404s/errors for
# every game tried — that's the provider's own response, not a bug here;
# don't treat "catalog synced" as "games are launchable" until that's
# resolved with the provider.
GAMING_PROVIDER_BASE_URL="https://igaming-one-psi.vercel.app/api"
GAMING_PROVIDER_API_KEY="CHANGE_ME"
MOCK_PROVIDER_PORT=4100

GAMING_WEBHOOK_SHARED_SECRET="CHANGE_ME"

# Required to call POST /api/catalog/sync (an operator action, not
# player-facing) — send it as `Authorization: Bearer <this value>`.
CATALOG_SYNC_SECRET="CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET"

JWT_ACCESS_SECRET="CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET"
JWT_REFRESH_SECRET="CHANGE_ME_GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

# Real-money PayIn/Payout aggregator (backend/src/modules/payments). Neither
# of its webhook callbacks is signature-verified — undocumented by the
# provider — see payments.service.ts for how that's mitigated instead.
PAYMENT_GATEWAY_BASE_URL="https://housholdbajar.com/api"
PAYMENT_GATEWAY_CLIENT_ID="CHANGE_ME"
PAYMENT_GATEWAY_SECRET_ID="CHANGE_ME"
# Builds the redirect_url sent with every PayIn order — where the player's
# browser returns to after paying (not where the payment result is
# reported; that's the callback URL configured on the gateway's own side).
PAYMENT_CALLBACK_BASE_URL="https://yourdomain.com"
# This backend's own public origin — used to build absolute URLs for support
# ticket image attachments, so admin/frontend (a different domain) can load
# them directly.
PUBLIC_BASE_URL="https://yourdomain.com"
