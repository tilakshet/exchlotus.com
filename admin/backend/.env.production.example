DATABASE_URL="postgresql://exchlotus_app:CHANGE_ME_SAME_AS_ROOT_ENV_PRODUCTION@postgres:5432/exchlotus_dev"
PORT=4600
NODE_ENV=production

REDIS_URL="redis://redis:6379"

# Same-origin requests from https://admin.yourdomain.com go through the
# admin frontend's own nginx reverse proxy (no CORS needed there). Listed
# here only for cross-origin callers (e.g. a teammate's local admin
# frontend pointed at the deployed admin API).
CORS_ORIGIN="https://admin.yourdomain.com"

# Own secret — never the same value as backend/.env.production's
# JWT_ACCESS_SECRET. A leaked player-facing secret must not also compromise
# admin sessions, and vice versa.
JWT_ACCESS_SECRET="CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET_DIFFERENT_FROM_PLAYER_BACKEND"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=7

MFA_ISSUER="Exchlotus Admin"

ADMIN_BOOTSTRAP_EMAIL="CHANGE_ME"
ADMIN_BOOTSTRAP_PASSWORD="CHANGE_ME_GENERATE_A_LONG_RANDOM_PASSWORD"

# Same aggregator/credentials as backend/.env.production — only the payout
# side is called from here, on admin approval of a withdrawal request.
PAYMENT_GATEWAY_BASE_URL="https://housholdbajar.com/api"
PAYMENT_GATEWAY_CLIENT_ID="CHANGE_ME"
PAYMENT_GATEWAY_SECRET_ID="CHANGE_ME"
