DATABASE_URL="postgresql://exchlotus_app:CHANGE_ME@127.0.0.1:5433/exchlotus_dev"
REDIS_URL="redis://127.0.0.1:6379"
PORT=4600
NODE_ENV=development

# Admin frontend's dev-server origin (Vite default 5174, kept off the
# player frontend's 5173) — only needed cross-origin in local dev; in
# production the admin frontend's nginx proxies same-origin (no CORS).
CORS_ORIGIN="http://localhost:5174,http://127.0.0.1:5174"

JWT_ACCESS_SECRET="CHANGE_ME"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=7

# TOTP issuer name shown in authenticator apps (Google Authenticator, etc.)
MFA_ISSUER="Exchlotus Admin"

# One-time bootstrap: on first `npm run seed`, creates a SUPER_ADMIN account
# with these credentials if no admin user exists yet. Change the password
# immediately after first login — the seed script does not re-run this once
# any AdminUser row exists.
ADMIN_BOOTSTRAP_EMAIL="superadmin@exchlotus.local"
ADMIN_BOOTSTRAP_PASSWORD="CHANGE_ME_ON_FIRST_LOGIN"
